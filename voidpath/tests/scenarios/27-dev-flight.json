[
  {"note": "G3-01: the Starchart flight home from Driftmarket after the Maw (coil in hand) lands the leader on the Halcyon's berth, and the autosave and the checkpoint keep that walkable spot; Continue lands there too"},
  {"waitFor": "window.__VP && window.__VP.ready", "timeout": 240000},
  {"eval": "window.S = () => window.__VP.debug.state()"},
  {"eval": "window.EX = () => window.__VP.ctx.game.states.explore"},
  {"eval": "window.WALK = (p) => !!p && p.map === EX().mapId && EX().world.walkable(p.x, p.z)"},
  {"eval": "window.AUTO = () => { try { return JSON.parse(localStorage.getItem('voidpath.save.auto') || 'null'); } catch (e) { return null; } }"},
  {"eval": "__VP.debug.jumpTo('ch1.return')"},
  {"waitFor": "S().state === 'explore' && S().map === 'driftmarket' && !S().transitioning && !S().cutscene", "timeout": 600000},
  {"eval": "__VP.debug.encounters(false)"},
  {"waitFor": "S().inventory.lattice_coil === 1"},
  {"eval": "window.__autos = S().autosaves, true"},

  {"note": "the dock Starchart (the player's path: an inline script that runs the flight nested inside it)"},
  {"eval": "__VP.debug.teleport(13.6, 6.2, 'up')"},
  {"wait": 500},
  {"eval": "__VP.debug.interact('starchart')"},
  {"waitFor": "S().ui.starchart", "timeout": 120000},
  {"wait": 800},
  {"until": "/halcyon/i.test(document.querySelector('.vp-star-node.is-sel .vp-star-lbl b')?.textContent || '')", "max": 8, "do": [{"key": "ArrowRight"}, {"wait": 500}]},
  {"shot": "01-starchart-halcyon"},
  {"key": "Enter"},
  {"waitFor": "S().map === 'moth' || S().map === 'halcyon'", "timeout": 600000},
  {"until": "S().map === 'halcyon' && !S().transitioning && !S().cutscene", "max": 400, "do": [{"if": "S().ui.dialog", "then": [{"key": "Enter"}]}, {"wait": 700}]},

  {"note": "the leader stands on the berth (40.1, 23.8), not at the cockpit's coordinates in the void (5.72, 3.28)"},
  {"log": "JSON.stringify({ leader: S().leader, pos: [S().explore.x, S().explore.z], checkpoint: S().checkpoint, auto: AUTO() && AUTO().pos, autosaves: S().autosaves })"},
  {"waitFor": "WALK({ map: S().map, x: S().explore.x, z: S().explore.z })", "timeout": 5000},
  {"waitFor": "Math.hypot(S().explore.x - 40.1, S().explore.z - 23.8) < 1.5", "timeout": 5000},
  {"waitFor": "S().checkpoint && S().checkpoint.map === 'halcyon' && WALK(S().checkpoint) && Math.hypot(S().checkpoint.x - 40.1, S().checkpoint.z - 23.8) < 1.5", "timeout": 5000},
  {"waitFor": "S().autosaves > __autos && AUTO() && WALK(AUTO().pos) && AUTO().pos.map === 'halcyon'", "timeout": 5000},
  {"waitFor": "!EX().world.npc('__leader') && EX().player.actor.object3d.visible", "timeout": 5000},
  {"wait": 1500},
  {"shot": "02-halcyon-berth"},

  {"note": "the player walks from there"},
  {"eval": "window.__p0 = [S().explore.x, S().explore.z], true"},
  {"until": "Math.hypot(S().explore.x - __p0[0], S().explore.z - __p0[1]) > 0.3", "max": 10, "do": [{"hold": "ArrowUp", "ms": 2500}]},

  {"note": "Continue restores that walkable spot"},
  {"eval": "__VP.ctx.game.continue(), true"},
  {"waitFor": "S().state === 'explore' && S().map === 'halcyon' && !S().transitioning", "timeout": 600000},
  {"wait": 1000},
  {"waitFor": "WALK({ map: S().map, x: S().explore.x, z: S().explore.z }) && Math.hypot(S().explore.x - 40.1, S().explore.z - 23.8) < 1.5", "timeout": 30000},
  {"shot": "03-continue"},
  {"log": "JSON.stringify({ pos: [S().explore.x, S().explore.z], checkpoint: S().checkpoint })"}
]
