[
  {"note": "Explore: real key holds in every area, BOLT, a crate, a Med-Station, the pause menu, the locked door, HALCYON, then a random encounter in the corridor"},
  {"waitFor": "window.__VP && window.__VP.ready", "timeout": 120000},
  {"eval": "window.S = () => window.__VP.debug.state()"},
  {"key": "Enter"}, {"wait": 700}, {"key": "Enter"},
  {"waitFor": "S().state === 'explore' && !S().transitioning", "timeout": 60000},
  {"eval": "__VP.debug.encounters(false)"},

  {"note": "Cryo Deck: walk right to BOLT and talk"},
  {"until": "S().ui.prompt === 'Talk'", "max": 25, "do": [{"hold": "ArrowRight", "ms": 350}]},
  {"wait": 500},
  {"shot": "01-cryo-bolt-prompt"},
  {"key": "Enter"},
  {"waitFor": "S().ui.dialog", "timeout": 15000},
  {"wait": 2500},
  {"shot": "02-bolt-dialog"},
  {"until": "!S().ui.dialog", "max": 40, "do": [{"if": "S().ui.dialog", "then": [{"key": "Enter"}]}, {"wait": 900}]},
  {"waitFor": "S().flags.talked_bolt === true"},

  {"note": "Cryo Deck: open the supply crate in the south-west corner"},
  {"eval": "__VP.debug.teleport(3.1, 28.2, 'left')"},
  {"until": "S().ui.prompt === 'Open'", "max": 25, "do": [{"hold": "ArrowLeft", "ms": 350}]},
  {"key": "Enter"},
  {"waitFor": "S().flags.crate_cryo_1 === true && S().ui.toasts.some((t) => /Medi-Gel/.test(t))", "timeout": 15000},
  {"wait": 1200},
  {"shot": "03-crate-opened"},

  {"note": "Cryo Deck: rest at the Med-Station (heal + checkpoint)"},
  {"eval": "__VP.debug.partyHp(100)"},
  {"eval": "__VP.debug.teleport(12.6, 19.7, 'up')"},
  {"until": "S().ui.prompt === 'Med-Station'", "max": 25, "do": [{"hold": "ArrowUp", "ms": 300}]},
  {"key": "Enter"},
  {"waitFor": "S().ui.dialog", "timeout": 15000},
  {"until": "S().ui.choice", "max": 10, "do": [{"key": "Enter"}, {"wait": 900}]},
  {"wait": 800},
  {"shot": "04-med-station-choice"},
  {"key": "Enter"},
  {"waitFor": "S().checkpoint !== null && S().party.every((p) => p.hp === p.maxHp)", "timeout": 15000},
  {"wait": 1000},
  {"shot": "05-med-station-rested"},

  {"note": "pause menu: party tab, items tab, close"},
  {"waitFor": "!S().ui.blocking", "timeout": 15000},
  {"key": "Tab"},
  {"waitFor": "S().ui.menu", "timeout": 10000},
  {"wait": 1500},
  {"shot": "06-pause-party"},
  {"key": "ArrowRight"},
  {"wait": 1500},
  {"shot": "07-pause-items"},
  {"key": "Escape"},
  {"waitFor": "!S().ui.menu", "timeout": 10000},

  {"note": "Spine Corridor: run east with Shift held"},
  {"eval": "__VP.debug.view('corridor')"},
  {"wait": 800},
  {"down": "ShiftLeft"}, {"hold": "ArrowRight", "ms": 4000}, {"up": "ShiftLeft"},
  {"waitFor": "S().explore.area === 'corridor' && S().explore.x > 17.6"},
  {"wait": 600},
  {"shot": "08-corridor"},

  {"note": "Engineering Bay: walk around the reactor"},
  {"eval": "__VP.debug.view('engineering')"},
  {"wait": 800},
  {"hold": "ArrowDown", "ms": 2500},
  {"hold": "ArrowRight", "ms": 2500},
  {"waitFor": "S().explore.area === 'engineering'"},
  {"wait": 600},
  {"shot": "09-engineering"},

  {"note": "Antechamber: the bridge door is locked without the keycard"},
  {"eval": "__VP.debug.teleport(41.0, 13.6, 'up')"},
  {"until": "S().ui.prompt === 'Inspect'", "max": 25, "do": [{"hold": "ArrowUp", "ms": 300}]},
  {"wait": 500},
  {"shot": "10-locked-door"},
  {"key": "Enter"},
  {"waitFor": "S().ui.dialog", "timeout": 15000},
  {"until": "!S().ui.dialog", "max": 20, "do": [{"if": "S().ui.dialog", "then": [{"key": "Enter"}]}, {"wait": 900}]},
  {"waitFor": "!S().flags.bridge_unlocked"},

  {"note": "Observation Bridge: talk to HALCYON (teleported past the door)"},
  {"eval": "__VP.debug.teleport(44.1, 9.5, 'right')"},
  {"wait": 600},
  {"until": "S().ui.prompt === 'Talk'", "max": 25, "do": [{"hold": "ArrowRight", "ms": 250}]},
  {"key": "Enter"},
  {"waitFor": "S().ui.dialog", "timeout": 15000},
  {"wait": 2500},
  {"shot": "11-bridge-halcyon"},
  {"until": "!S().ui.dialog", "max": 40, "do": [{"if": "S().ui.dialog", "then": [{"key": "Enter"}]}, {"wait": 900}]},
  {"waitFor": "S().flags.talked_halcyon === true"},

  {"note": "random encounter: pace the corridor until the danger gauge fires"},
  {"eval": "__VP.debug.teleport(12.5, 14.6, 'right')"},
  {"eval": "__VP.debug.encounters(true)"},
  {"until": "S().state === 'battle' || S().transitioning", "max": 40, "do": [
    {"down": "ShiftLeft"}, {"hold": "ArrowRight", "ms": 2500}, {"hold": "ArrowLeft", "ms": 2500}, {"up": "ShiftLeft"}
  ]},
  {"log": "JSON.stringify({ steps: S().stats.steps, danger: S().explore && S().explore.danger })"},
  {"waitFor": "S().state === 'battle' && !S().transitioning", "timeout": 60000},
  {"waitFor": "S().battle.menu === 'main' || S().battle.phase === 'enemyTurn'", "timeout": 90000},
  {"shot": "12-random-battle"},
  {"eval": "__VP.debug.winBattle()"},
  {"waitFor": "S().battle && S().battle.results", "timeout": 120000},
  {"wait": 800},
  {"shot": "13-random-battle-won"},
  {"key": "Enter"},
  {"waitFor": "S().state === 'explore' && !S().transitioning && S().explore.area === 'corridor'", "timeout": 60000},
  {"waitFor": "S().music === 'explore' && S().stats.battles === 1"},
  {"wait": 800},
  {"shot": "14-back-in-corridor"}
]
