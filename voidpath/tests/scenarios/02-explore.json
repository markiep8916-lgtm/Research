[
  {"note": "Explore (POC party via jumpTo('poc')): real key holds, BOLT, a crate, a Med-Station, the pause menu, the Spine Corridor and Engineering, a terminal, the locked bridge door, the Moth's berth, then a random encounter in the corridor"},
  {"waitFor": "window.__VP && window.__VP.ready", "timeout": 240000},
  {"eval": "window.S = () => window.__VP.debug.state()"},
  {"waitFor": "S().state === 'title' && S().ui.title === 'press'", "timeout": 120000},
  {"key": "Enter"}, {"waitFor": "S().ui.title === 'menu'"}, {"wait": 700},
  {"eval": "__VP.debug.skip(true)"},
  {"key": "Enter"},
  {"waitFor": "S().map === 'halcyon' && S().cutscene === null && !S().transitioning && !S().ui.blocking", "timeout": 400000},
  {"eval": "__VP.debug.skip(false)"},
  {"eval": "__VP.debug.jumpTo('poc')"},
  {"waitFor": "S().partyIds.length === 4 && S().map === 'halcyon' && !S().transitioning && S().objective === 'pro.find_keycard'", "timeout": 240000},
  {"waitFor": "S().flags['story:nyx_joined'] && !S().flags['story:bridge_unlocked'] && !S().inventory.keycard"},
  {"eval": "__VP.debug.encounters(false)"},

  {"note": "Cryo Deck: BOLT follows the leader; talk to him"},
  {"eval": "__VP.debug.teleport(7.2, 20.75, 'right')"},
  {"waitFor": "S().ui.prompt === 'Talk'", "timeout": 240000},
  {"wait": 500},
  {"shot": "01-cryo-bolt-prompt"},
  {"key": "Enter"},
  {"waitFor": "S().ui.dialog", "timeout": 120000},
  {"waitFor": "document.querySelector('.vp-dlg.is-waiting')", "timeout": 400000},
  {"wait": 2500},
  {"shot": "02-bolt-dialog"},
  {"until": "!S().ui.dialog", "max": 80, "do": [{"if": "S().ui.dialog", "then": [{"key": "Enter"}]}, {"wait": 1500}]},
  {"waitFor": "S().flags['talk:halcyon:bolt'] === true"},

  {"note": "Cryo Deck: open the supply crate in the south-west corner"},
  {"eval": "__VP.debug.teleport(3.1, 28.2, 'left')"},
  {"until": "S().ui.prompt === 'Open'", "max": 40, "do": [{"hold": "ArrowLeft", "ms": 800}]},
  {"key": "Enter"},
  {"waitFor": "S().flags['chest:halcyon:cryo_1'] === true && S().ui.toasts.some((t) => /Medi-Gel/.test(t))", "timeout": 120000},
  {"wait": 1200},
  {"shot": "03-crate-opened"},

  {"note": "Cryo Deck: rest at the Med-Station (heal + checkpoint)"},
  {"eval": "__VP.debug.partyHp(100)"},
  {"eval": "window.CP0 = JSON.stringify(S().checkpoint), true"},
  {"eval": "__VP.debug.teleport(12.6, 19.7, 'up')"},
  {"until": "S().ui.prompt === 'Med-Station'", "max": 40, "do": [{"hold": "ArrowUp", "ms": 800}]},
  {"key": "Enter"},
  {"waitFor": "S().ui.dialog", "timeout": 120000},
  {"until": "S().ui.choice", "max": 40, "do": [{"key": "Enter"}, {"wait": 1500}]},
  {"wait": 800},
  {"shot": "04-med-station-choice"},
  {"key": "Enter"},
  {"waitFor": "JSON.stringify(S().checkpoint) !== CP0 && S().party.every((p) => p.hp === p.maxHp)", "timeout": 120000},
  {"wait": 1000},
  {"shot": "05-med-station-rested"},

  {"note": "pause menu: party tab, items tab, close"},
  {"waitFor": "!S().ui.blocking && S().cutscene === null", "timeout": 120000},
  {"key": "Tab"},
  {"waitFor": "S().ui.menu", "timeout": 120000},
  {"wait": 1500},
  {"shot": "06-pause-party"},
  {"key": "ArrowRight"},
  {"wait": 1500},
  {"shot": "07-pause-items"},
  {"key": "Escape"},
  {"waitFor": "!S().ui.menu", "timeout": 120000},

  {"note": "Spine Corridor: run east with Shift held"},
  {"eval": "__VP.debug.view('corridor')"},
  {"wait": 800},
  {"until": "S().explore.area === 'corridor' && S().explore.x > 17.6", "max": 40, "do": [{"down": "ShiftLeft"}, {"hold": "ArrowRight", "ms": 2000}, {"up": "ShiftLeft"}]},
  {"wait": 600},
  {"shot": "08-corridor"},

  {"note": "Engineering Bay: walk around the reactor, read the reactor terminal"},
  {"eval": "__VP.debug.view('engineering')"},
  {"eval": "window.S0 = S().stats.steps, true"},
  {"wait": 800},
  {"until": "S().stats.steps > S0 + 1", "max": 40, "do": [{"hold": "ArrowDown", "ms": 2500}, {"hold": "ArrowRight", "ms": 2500}]},
  {"waitFor": "S().explore.area === 'engineering'"},
  {"wait": 600},
  {"shot": "09-engineering"},
  {"eval": "__VP.debug.teleport(19.6, 25.4, 'up')"},
  {"until": "S().ui.prompt === 'Access'", "max": 40, "do": [{"hold": "ArrowUp", "ms": 800}]},
  {"key": "Enter"},
  {"waitFor": "S().ui.dialog", "timeout": 120000},
  {"waitFor": "document.querySelector('.vp-dlg.is-waiting')", "timeout": 400000},
  {"wait": 2000},
  {"shot": "10-reactor-terminal"},
  {"until": "!S().ui.dialog && S().cutscene === null", "max": 80, "do": [{"if": "S().ui.dialog", "then": [{"key": "Enter"}]}, {"wait": 1500}]},

  {"note": "Antechamber: the bridge door is locked without the keycard"},
  {"eval": "__VP.debug.teleport(41.0, 13.6, 'up')"},
  {"until": "S().ui.prompt === 'Inspect'", "max": 40, "do": [{"hold": "ArrowUp", "ms": 800}]},
  {"wait": 500},
  {"shot": "11-locked-door"},
  {"key": "Enter"},
  {"waitFor": "S().ui.dialog", "timeout": 120000},
  {"until": "!S().ui.dialog && S().cutscene === null", "max": 80, "do": [{"if": "S().ui.dialog", "then": [{"key": "Enter"}]}, {"wait": 1500}]},
  {"waitFor": "!S().flags['story:bridge_unlocked']"},

  {"note": "the Moth in her berth, south of the antechamber"},
  {"eval": "__VP.debug.view('berth')"},
  {"wait": 600},
  {"waitFor": "S().explore.area === 'berth'", "timeout": 60000},
  {"wait": 800},
  {"shot": "12-berth"},

  {"note": "random encounter: pace the corridor until the danger gauge fires"},
  {"eval": "window.B0 = S().stats.battles, true"},
  {"eval": "__VP.debug.teleport(12.5, 14.6, 'right')"},
  {"note": "the POC party out-levels the prologue zones by more than the weak-encounter gap: let weak encounters through"},
  {"eval": "__VP.ctx.ui.setSetting('skipWeak', false), true"},
  {"note": "software GL crawls (a few frames a second), so the dice are loaded while pacing: every other Math.random call reads low, the danger gauge, the zone, the roll and the table pick stay real"},
  {"eval": "window.RND = Math.random, window.RNDI = 0, Math.random = () => (RNDI++ % 2 ? RND() : 0.004), true"},
  {"eval": "__VP.debug.encounters(true)"},
  {"until": "S().state === 'battle' || S().transitioning", "max": 120, "do": [
    {"down": "ShiftLeft"}, {"hold": "ArrowRight", "ms": 2500}, {"hold": "ArrowLeft", "ms": 2500}, {"up": "ShiftLeft"}
  ]},
  {"eval": "Math.random = RND, true"},
  {"log": "JSON.stringify({ steps: S().stats.steps, danger: S().explore && S().explore.danger })"},
  {"waitFor": "S().state === 'battle' && !S().transitioning", "timeout": 240000},
  {"waitFor": "S().battle && (S().battle.menu === 'main' || S().battle.phase === 'enemyTurn')", "timeout": 400000},
  {"shot": "13-random-battle"},
  {"eval": "__VP.debug.winBattle()"},
  {"waitFor": "S().battle && S().battle.results", "timeout": 400000},
  {"wait": 800},
  {"shot": "14-random-battle-won"},
  {"key": "Enter"},
  {"waitFor": "S().state === 'explore' && !S().transitioning && S().explore.area === 'corridor'", "timeout": 240000},
  {"waitFor": "S().music === 'explore' && S().stats.battles === B0 + 1", "timeout": 60000},
  {"wait": 800},
  {"shot": "15-back-in-corridor"}
]
