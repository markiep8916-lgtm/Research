[
  {"note": "Phone (run with --mobile): title by taps, the field, the A button on BOLT, a battle driven by tapping menu rows"},
  {"waitFor": "window.__VP && window.__VP.ready", "timeout": 120000},
  {"eval": "window.S = () => window.__VP.debug.state()"},
  {"wait": 2500},
  {"shot": "01-title"},
  {"tapOn": ".vp-title .vp-press"},
  {"waitFor": "S().ui.title === 'menu'"},
  {"wait": 700},
  {"shot": "02-title-menu"},
  {"tapOn": ".vp-title-menu .vp-row", "nth": 0},
  {"waitFor": "S().state === 'explore' && !S().transitioning", "timeout": 60000},
  {"eval": "__VP.debug.encounters(false)"},
  {"wait": 1500},
  {"shot": "03-explore"},

  {"note": "walk up to BOLT and press the A button"},
  {"eval": "__VP.debug.teleport(7.2, 20.75, 'right')"},
  {"waitFor": "S().ui.prompt === 'Talk'", "timeout": 15000},
  {"wait": 600},
  {"shot": "04-a-button-prompt"},
  {"tapOn": ".vp-tc-a"},
  {"waitFor": "S().ui.dialog", "timeout": 15000},
  {"wait": 2200},
  {"shot": "05-dialog"},
  {"until": "!S().ui.dialog", "max": 40, "do": [{"if": "S().ui.dialog", "then": [{"tapOn": ".vp-dlg-panel"}]}, {"wait": 900}]},
  {"waitFor": "S().flags.talked_bolt === true"},

  {"note": "a battle: tap Attack, tap Rifle, confirm the target with A; ORION taps Skills > Volt Chain"},
  {"eval": "__VP.debug.startBattle('drone_single', { seed: 3 })"},
  {"eval": "__VP.debug.speed(2)"},
  {"waitFor": "S().battle && S().battle.actor === 'nyx' && S().battle.menu === 'main'", "timeout": 180000},
  {"wait": 900},
  {"shot": "06-battle-menu"},
  {"tapOn": ".vb-it", "nth": 0},
  {"waitFor": "S().battle.menu === 'weapons'"},
  {"tapOn": ".vb-it", "nth": 0},
  {"waitFor": "S().battle.menu === 'target'"},
  {"wait": 800},
  {"shot": "07-battle-target"},
  {"tapOn": ".vp-tc-a"},
  {"waitFor": "S().battle.menu === null"},
  {"waitFor": "S().battle.actor === 'orion' && S().battle.menu === 'main'", "timeout": 180000},
  {"tapOn": ".vb-it", "nth": 1},
  {"waitFor": "S().battle.menu === 'skills'"},
  {"wait": 600},
  {"shot": "08-battle-skills"},
  {"tapOn": ".vb-it", "nth": 2},
  {"waitFor": "S().battle.menu === 'target'"},
  {"tapOn": ".vp-tc-a"},
  {"waitFor": "S().battle.menu === null"},
  {"waitFor": "S().battle.enemies[0].broken", "timeout": 120000},
  {"eval": "__VP.debug.winBattle()"},
  {"waitFor": "S().battle && S().battle.results", "timeout": 180000},
  {"wait": 1500},
  {"shot": "09-battle-results"},
  {"tapOn": ".vb-res"},
  {"waitFor": "S().state === 'explore' && !S().transitioning", "timeout": 60000},
  {"wait": 1200},
  {"shot": "10-back-in-field"}
]
