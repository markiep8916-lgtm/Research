[
  {"note": "Losing a scripted dev battle and choosing Retry replays its trigger with the pre-fight part auto-skipped"},
  {"waitFor": "window.__VP && window.__VP.ready", "timeout": 240000},
  {"eval": "window.S = () => window.__VP.debug.state()"},
  {"eval": "__VP.debug.jumpTo('dev.fight')"},
  {"waitFor": "S().state === 'explore' && S().map === 'dev_box' && !S().transitioning", "timeout": 240000},
  {"eval": "__VP.debug.encounters(false)"},
  {"eval": "__VP.debug.autoResolve('lose')"},
  {"eval": "window.__says = 0, (() => { const d = __VP.ctx.ui.dialog; const show = d.show.bind(d); d.show = (l, o) => (__says++, show(l, o)); })(), true"},

  {"note": "walk east into the trigger: the pre-fight lines play, then the battle is lost"},
  {"eval": "__VP.debug.teleport(13.4, 16.4, 'right')"},
  {"until": "S().cutscene === 'dev.fight'", "max": 20, "do": [{"hold": "ArrowRight", "ms": 3000}]},
  {"waitFor": "S().ui.dialog", "timeout": 120000},
  {"wait": 1800},
  {"shot": "01-pre-fight"},
  {"until": "S().inBattle", "max": 120, "do": [{"if": "S().ui.dialog", "then": [{"key": "Enter"}]}, {"wait": 900}]},
  {"waitFor": "S().ui.screen === 'Signal lost'", "timeout": 240000},
  {"note": "the script waits on its battle (a Retry from a second form would resume it); the trigger is not marked seen"},
  {"waitFor": "S().cutscene === 'dev.fight' && !S().flags['seen:dev_box:dev.fight']"},
  {"wait": 2000},
  {"shot": "02-game-over"},

  {"note": "Retry: back at the checkpoint, the trigger is still armed"},
  {"until": "!S().ui.screen", "max": 20, "do": [{"key": "Enter"}, {"wait": 1500}]},
  {"waitFor": "S().state === 'explore' && !S().transitioning && S().map === 'dev_box' && S().cutscene === null", "timeout": 240000},
  {"waitFor": "Math.abs(S().explore.x - S().checkpoint.x) < 0.05 && Math.abs(S().explore.z - S().checkpoint.z) < 0.05"},
  {"waitFor": "S().party.every((p) => p.alive && p.hp === p.maxHp)"},
  {"wait": 1000},
  {"shot": "03-retry-at-checkpoint"},
  {"eval": "__VP.debug.autoResolve('win'), window.__says = 0, true"},
  {"eval": "__VP.debug.teleport(13.4, 16.4, 'right')"},
  {"until": "S().cutscene === 'dev.fight'", "max": 20, "do": [{"hold": "ArrowRight", "ms": 3000}]},
  {"waitFor": "S().inBattle || S().ui.dialog", "timeout": 120000},
  {"log": "JSON.stringify({ says: __says, inBattle: S().inBattle })"},
  {"waitFor": "__says === 0", "timeout": 1000},
  {"note": "the aftermath plays normally"},
  {"waitFor": "S().ui.dialog && !S().inBattle", "timeout": 240000},
  {"waitFor": "__says === 1"},
  {"wait": 1800},
  {"shot": "04-aftermath"},
  {"until": "S().cutscene === null", "max": 80, "do": [{"key": "Enter"}, {"wait": 900}]},
  {"waitFor": "S().flags['seen:dev_box:dev.fight'] === true && S().flags['dev:fight_won'] === true"},
  {"log": "JSON.stringify({ played: S().played, autosaves: S().autosaves })"}
]
