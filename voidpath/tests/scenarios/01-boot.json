[
  {"note": "Boot: the loading screen, the title, Enter to the menu, Enter on New Journey, the first field frame"},
  {"wait": 500},
  {"shot": "01-loading"},
  {"waitFor": "window.__VP && window.__VP.ready", "timeout": 120000},
  {"eval": "window.S = () => window.__VP.debug.state()"},
  {"waitFor": "S().state === 'title' && S().ui.title === 'press' && S().music === 'title'"},
  {"wait": 3000},
  {"shot": "02-title"},
  {"key": "Enter"},
  {"waitFor": "S().ui.title === 'menu'"},
  {"wait": 800},
  {"shot": "03-title-menu"},
  {"key": "Enter"},
  {"waitFor": "S().transitioning", "timeout": 10000},
  {"waitFor": "S().state === 'explore' && !S().transitioning", "timeout": 60000},
  {"waitFor": "S().music === 'explore' && S().explore.area === 'cryo' && !S().ui.blocking"},
  {"wait": 1200},
  {"shot": "04-cryo-deck"},
  {"until": "S().stats.steps > 1", "max": 12, "do": [{"hold": "ArrowDown", "ms": 600}]},
  {"waitFor": "S().explore.z > 20.6"},
  {"wait": 600},
  {"shot": "05-first-steps"},
  {"log": "JSON.stringify(S())"}
]
