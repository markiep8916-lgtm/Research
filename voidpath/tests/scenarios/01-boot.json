[
  {"note": "Boot: the loading screen, the title, Enter to the menu, Enter on New Journey -> the cold open over Tethys (WARDEN) -> the PROLOGUE card -> Kade wakes in pod 07 with BOLT (scripts fast) -> the first steps on the Cryo Deck"},
  {"wait": 500},
  {"shot": "01-loading"},
  {"waitFor": "window.__VP && window.__VP.ready", "timeout": 240000},
  {"eval": "window.S = () => window.__VP.debug.state()"},
  {"waitFor": "S().state === 'title' && S().ui.title === 'press' && S().music === 'title'"},
  {"wait": 3000},
  {"shot": "02-title"},
  {"key": "Enter"},
  {"waitFor": "S().ui.title === 'menu'"},
  {"wait": 800},
  {"shot": "03-title-menu"},
  {"eval": "__VP.debug.skip(true)"},
  {"key": "Enter"},
  {"waitFor": "S().transitioning", "timeout": 60000},
  {"waitFor": "S().map === 'exterior' && S().cutscene === 'prologue.new_journey'", "timeout": 400000},
  {"waitFor": "S().music === 'warden' && S().partyIds.join() === 'kade' && S().leader === 'kade'"},
  {"wait": 600},
  {"shot": "04-cold-open"},
  {"waitFor": "S().map === 'halcyon' && S().cutscene === null && !S().transitioning && !S().ui.blocking", "timeout": 400000},
  {"eval": "__VP.debug.skip(false)"},
  {"waitFor": "S().state === 'explore' && S().music === 'explore' && S().explore.area === 'cryo' && S().flags['story:kade_awake']"},
  {"waitFor": "S().partyIds.join() === 'kade' && S().leader === 'kade' && S().objective === 'pro.wake' && S().chapter === 'prologue'"},
  {"waitFor": "S().autosaves === 1 && S().checkpoint && S().checkpoint.map === 'halcyon'"},
  {"wait": 1200},
  {"shot": "05-cryo-deck"},
  {"until": "S().stats.steps > 1 && S().explore.z > 20.6", "max": 40, "do": [{"hold": "ArrowDown", "ms": 2500}]},
  {"waitFor": "S().explore.z > 20.6"},
  {"wait": 600},
  {"shot": "06-first-steps"},
  {"log": "JSON.stringify({ map: S().map, area: S().explore.area, flags: S().flags, autosaves: S().autosaves, checkpoint: S().checkpoint })"}
]
