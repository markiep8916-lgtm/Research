[
  {"note": "Prologue with other leaders (C1, 11.3), battles resolved through the model (autoResolve): jumpTo('pro.lower') -> Sera leads Orion's rescue -> Orion leads into the gallery ambush, to Brandt's keycard and Nyx's door -> Sera finds Kade's coded locker (leader hint) -> Sera leads into the SENTINEL -> the CHAPTER ONE card (Nyx leads) -> the Starchart and the Moth's first flight to Driftmarket"},
  {"waitFor": "window.__VP && window.__VP.ready", "timeout": 300000},
  {"eval": "window.S = () => window.__VP.debug.state()"},
  {"eval": "window.BATTLE = () => S().state === 'battle' && !!(S().battle && S().battle.results || document.querySelector('.vb-say.is-on.is-done'))"},
  {"eval": "window.LEAD = (id) => (__VP.ctx.ui.hook('setLeader', id), S().leader === id)"},
  {"eval": "__VP.debug.jumpTo('pro.lower').then((s) => { window.J = s; })"},
  {"waitFor": "window.J && S().state === 'explore' && !S().transitioning && S().map === 'halcyon'", "timeout": 400000},
  {"waitFor": "S().partyIds.join() === 'kade,sera' && S().objective === 'pro.reach_engineering'"},
  {"eval": "__VP.debug.encounters(false)"},
  {"eval": "__VP.debug.skip(true)"},
  {"eval": "__VP.debug.autoResolve('policy')"},

  {"note": "Sera leads: the rescue before the reactor-control shutters"},
  {"waitFor": "LEAD('sera')", "timeout": 10000},
  {"eval": "__VP.debug.view('control')"},
  {"wait": 1500},
  {"shot": "01-sera-leads"},
  {"eval": "__VP.debug.heal()"},
  {"eval": "__VP.debug.teleport(27.6, 35.6, 'left')"},
  {"until": "S().cutscene === 'prologue.orion_rescue' || S().inBattle", "max": 40, "do": [{"down": "ShiftLeft"}, {"hold": "ArrowLeft", "ms": 1500}, {"up": "ShiftLeft"}]},
  {"until": "S().flags['story:orion_joined'] && S().state === 'explore' && !S().cutscene && !S().transitioning", "max": 400, "do": [{"if": "BATTLE()", "then": [{"key": "Enter"}]}, {"wait": 1500}]},
  {"waitFor": "S().leader === 'sera' && S().partyIds.join() === 'kade,sera,orion' && S().objective === 'pro.find_keycard'"},

  {"note": "Orion leads: Brandt's keycard, then the antechamber (Nyx and the squad)"},
  {"waitFor": "LEAD('orion')", "timeout": 10000},
  {"note": "Orion leads into the gallery ambush (he speaks as the leader, no step-out)"},
  {"eval": "window.B0 = S().stats.battles, true"},
  {"eval": "__VP.debug.teleport(19.6, 36.2, 'left')"},
  {"until": "S().cutscene === 'prologue.gallery_ambush' || S().inBattle", "max": 40, "do": [{"hold": "ArrowLeft", "ms": 1500}]},
  {"waitFor": "S().state === 'explore' && !S().inBattle && !S().transitioning && !S().cutscene && S().stats.battles === B0 + 1 && S().flags['seen:halcyon:gallery_ambush']", "timeout": 600000},
  {"eval": "__VP.debug.heal()"},
  {"eval": "__VP.debug.interact('brandt')"},
  {"waitFor": "S().inventory.keycard === 1 && S().objective === 'pro.reach_bridge' && !S().cutscene", "timeout": 400000},
  {"eval": "__VP.debug.heal()"},
  {"eval": "__VP.debug.teleport(36.3, 14.6, 'right')"},
  {"until": "S().cutscene === 'prologue.nyx_door' || S().inBattle", "max": 40, "do": [{"down": "ShiftLeft"}, {"hold": "ArrowRight", "ms": 1500}, {"up": "ShiftLeft"}]},
  {"until": "S().flags['story:nyx_joined'] && S().state === 'explore' && !S().cutscene && !S().transitioning", "max": 400, "do": [{"if": "BATTLE()", "then": [{"key": "Enter"}]}, {"wait": 1500}]},
  {"waitFor": "S().leader === 'orion' && S().partyIds.length === 4 && S().objective === 'pro.open_bridge'"},
  {"wait": 1000},
  {"shot": "02-orion-leads-antechamber"},

  {"note": "Sera leads: Kade's coded locker only answers to Kade"},
  {"waitFor": "LEAD('sera')", "timeout": 10000},
  {"eval": "__VP.debug.interact('kade_locker')"},
  {"waitFor": "S().cutscene === null && !S().ui.dialog", "timeout": 400000},
  {"waitFor": "!S().flags['pro:kade_locker']"},

  {"note": "rest, the bridge door, the SENTINEL (won outright), the aftermath with Sera leading"},
  {"eval": "__VP.debug.choices([0])"},
  {"eval": "__VP.debug.interact('med_ante')"},
  {"waitFor": "!S().cutscene && S().party.every((p) => p.hp === p.maxHp)", "timeout": 400000},
  {"eval": "__VP.debug.teleport(41.0, 13.4, 'up')"},
  {"eval": "__VP.debug.interact('bridge_door')"},
  {"waitFor": "S().flags['story:bridge_unlocked']", "timeout": 400000},
  {"waitFor": "S().flags['seen:halcyon:bridge_open'] && S().objective === 'pro.sentinel' && !S().cutscene", "timeout": 400000},
  {"eval": "__VP.debug.autoResolve('win')"},
  {"eval": "__VP.debug.teleport(41.0, 9.4, 'up')"},
  {"eval": "__VP.debug.interact('sentinel')"},
  {"waitFor": "S().cutscene === 'prologue.sentinel'", "timeout": 400000},
  {"waitFor": "S().chapter === 'ch1' && S().flags['story:prologue_done'] && !S().cutscene && !S().transitioning && !S().ui.blocking", "timeout": 1200000},
  {"waitFor": "S().leader === 'nyx' && S().flags['unlock:driftmarket'] && S().objective === 'ch1.go_driftmarket'"},

  {"note": "HALCYON's fragment on her projector"},
  {"eval": "__VP.debug.interact('halcyon')"},
  {"waitFor": "S().cutscene === null && !S().ui.dialog && S().flags['talk:halcyon:halcyon']", "timeout": 400000},

  {"note": "the Starchart: the Moth's first flight to Driftmarket"},
  {"eval": "__VP.debug.interact('starchart')"},
  {"waitFor": "S().ui.starchart", "timeout": 400000},
  {"wait": 1200},
  {"shot": "03-starchart"},
  {"note": "the flight at normal speed: Nyx flies her own ship"},
  {"eval": "__VP.debug.skip(false)"},
  {"key": "Enter"},
  {"waitFor": "S().map === 'moth'", "timeout": 400000},
  {"waitFor": "S().ui.dialog", "timeout": 400000},
  {"waitFor": "document.querySelector('.vp-dlg.is-waiting')", "timeout": 400000},
  {"wait": 2000},
  {"shot": "04-moth-flight"},
  {"eval": "__VP.debug.skip(true)"},
  {"until": "S().map === 'driftmarket'", "max": 300, "do": [{"if": "S().ui.dialog", "then": [{"key": "Enter"}]}, {"wait": 1500}]},
  {"waitFor": "S().flags['pro:flight_driftmarket'] && S().flags['dest:driftmarket']", "timeout": 240000},
  {"log": "JSON.stringify({ map: S().map, chapter: S().chapter, leader: S().leader, flags: Object.keys(S().flags).filter((f) => /^(pro|story|dest|unlock):/.test(f)) })"}
]
