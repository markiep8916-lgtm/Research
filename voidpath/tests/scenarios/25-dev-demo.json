[
  {"note": "debug.runScript('dev.demo') runs every cs call without errors, a screenshot per step; its save and checkpoint are written only when the script ends"},
  {"waitFor": "window.__VP && window.__VP.ready", "timeout": 240000},
  {"eval": "window.S = () => window.__VP.debug.state()"},
  {"eval": "__VP.debug.jumpTo('dev')"},
  {"waitFor": "S().state === 'explore' && S().map === 'dev_box' && !S().transitioning", "timeout": 240000},
  {"eval": "__VP.debug.encounters(false)"},
  {"eval": "__VP.debug.autoResolve('win')"},
  {"eval": "window.A0 = S().autosaves, window.C0 = JSON.stringify(S().checkpoint), window.__steps = [], __VP.ctx.story.onChange((c) => { if (c.name === 'dev:step') __steps.push([c.value, __VP.game.autosaves, JSON.stringify(__VP.ctx.state.checkpoint)]); }), true"},
  {"eval": "__VP.debug.runScript('dev.demo', { hold: 2, ending: true })"},
  {"waitFor": "S().cutscene === 'dev.demo'", "timeout": 30000},

  {"until": "S().flags['dev:step'] >= 1", "max": 240, "do": [{"if": "S().ui.dialog", "then": [{"key": "Enter"}]}, {"wait": 700}]},
  {"shot": "01-scene-letterbox-banner"},
  {"until": "S().flags['dev:step'] >= 2", "max": 240, "do": [{"if": "S().ui.dialog", "then": [{"key": "Enter"}]}, {"wait": 700}]},
  {"shot": "02-spawn-hologram-emote"},
  {"waitFor": "S().ui.dialog", "timeout": 120000},
  {"wait": 2500},
  {"shot": "03a-say-expression"},
  {"until": "S().ui.dialog && document.querySelector('.vp-dlg.is-open') && /mood/.test(document.querySelector('.vp-dlg.is-open .vp-dlg-text, .vp-dlg.is-open')?.textContent || '')", "max": 200, "do": [{"key": "Enter"}, {"wait": 900}]},
  {"wait": 2500},
  {"shot": "03b-mood-speaker"},
  {"until": "S().flags['dev:step'] >= 3", "max": 240, "do": [{"if": "S().ui.dialog", "then": [{"key": "Enter"}]}, {"wait": 700}]},
  {"shot": "03c-after-dialogue"},
  {"until": "S().ui.dialog", "max": 240, "do": [{"wait": 500}]},
  {"wait": 2000},
  {"shot": "04a-gathered-sera-speaks"},
  {"until": "S().flags['dev:step'] >= 4", "max": 240, "do": [{"if": "S().ui.dialog", "then": [{"key": "Enter"}]}, {"wait": 700}]},
  {"shot": "04b-ungathered"},
  {"until": "S().flags['dev:step'] >= 5", "max": 240, "do": [{"if": "S().ui.dialog", "then": [{"key": "Enter"}]}, {"wait": 700}]},
  {"shot": "05-camera"},
  {"until": "S().ui.dialog", "max": 240, "do": [{"wait": 500}]},
  {"wait": 1500},
  {"shot": "06a-narration-over-fade"},
  {"until": "S().ui.dialog && (document.querySelector('.vp-dlg.is-open')?.textContent || '').includes('memory')", "max": 200, "do": [{"if": "S().ui.dialog", "then": [{"key": "Enter"}]}, {"wait": 900}]},
  {"wait": 2500},
  {"shot": "06b-memory-look"},
  {"until": "S().flags['dev:step'] >= 6", "max": 240, "do": [{"if": "S().ui.dialog", "then": [{"key": "Enter"}]}, {"wait": 700}]},
  {"shot": "06c-screens-caption"},
  {"until": "S().flags['dev:step'] >= 7", "max": 240, "do": [{"if": "S().ui.dialog", "then": [{"key": "Enter"}]}, {"wait": 700}]},
  {"shot": "07-world"},
  {"until": "S().flags['dev:step'] >= 8", "max": 240, "do": [{"if": "S().ui.dialog", "then": [{"key": "Enter"}]}, {"wait": 700}]},
  {"wait": 600},
  {"shot": "08-state-toasts"},
  {"log": "JSON.stringify({ objective: S().objective, leader: S().leader, party: S().partyIds, credits: S().credits, medigel: S().inventory.medigel })"},

  {"note": "the choice waits for input; the queued save is not written yet"},
  {"waitFor": "S().ui.choice", "timeout": 120000},
  {"wait": 1500},
  {"shot": "09-choice"},
  {"waitFor": "S().autosaves === A0 && JSON.stringify(S().checkpoint) === C0"},
  {"key": "Enter"},
  {"until": "S().flags['dev:step'] >= 10", "max": 300, "do": [{"if": "S().ui.dialog", "then": [{"key": "Enter"}]}, {"wait": 900}]},
  {"shot": "10-goto-and-back"},
  {"until": "S().flags['dev:step'] >= 11", "max": 300, "do": [{"if": "S().ui.dialog", "then": [{"key": "Enter"}]}, {"wait": 900}]},
  {"shot": "11-after-battle"},
  {"waitFor": "S().ui.shop", "timeout": 120000},
  {"wait": 1500},
  {"shot": "12a-shop"},
  {"until": "!S().ui.shop", "max": 10, "do": [{"key": "Escape"}, {"wait": 1200}]},
  {"waitFor": "S().ui.starchart", "timeout": 120000},
  {"wait": 1500},
  {"shot": "12b-starchart"},
  {"until": "!S().ui.starchart", "max": 10, "do": [{"key": "Escape"}, {"wait": 1200}]},
  {"until": "S().ui.card", "max": 240, "do": [{"if": "S().ui.dialog", "then": [{"key": "Enter"}]}, {"wait": 500}]},
  {"wait": 2500},
  {"shot": "12c-chapter-card"},
  {"until": "S().flags['dev:step'] >= 12", "max": 240, "do": [{"if": "S().ui.dialog", "then": [{"key": "Enter"}]}, {"wait": 700}]},
  {"shot": "12d-after-card"},
  {"until": "S().flags['dev:step'] >= 13", "max": 240, "do": [{"if": "S().ui.dialog", "then": [{"key": "Enter"}]}, {"wait": 700}]},
  {"shot": "13-clean-up"},

  {"note": "cs.ending writes the queued save first, then credits, THE END and the stats"},
  {"waitFor": "S().autosaves === A0 + 1", "timeout": 120000},
  {"waitFor": "S().ui.card", "timeout": 120000},
  {"wait": 4000},
  {"shot": "14-credits"},
  {"until": "S().ui.screen === 'Journey complete'", "max": 300, "do": [{"key": "Enter"}, {"wait": 1500}]},
  {"wait": 2000},
  {"shot": "15-journey-complete"},
  {"until": "!S().ui.screen", "max": 10, "do": [{"key": "Enter"}, {"wait": 1500}]},
  {"waitFor": "S().cutscene === null && S().state === 'explore'", "timeout": 120000},
  {"wait": 1000},
  {"shot": "16-back-in-field"},
  {"log": "JSON.stringify({ autosaves: S().autosaves, checkpoint: S().checkpoint, played: S().played, leader: S().leader, steps: __steps })"},
  {"note": "every step ran with the save still queued; exactly one autosave once the script ended"},
  {"waitFor": "__steps.length === 13 && __steps.every(([, a]) => a === A0) && S().autosaves === A0 + 1 && S().played.includes('dev.demo')"}
]
