[
  {"note": "Boss (POC party via jumpTo('poc')): Brandt's keycard crate, the Med-Station, the bridge door, the SENTINEL confrontation, the boss fight on the stage to its first Break, victory, the aftermath (HALCYON's fragment, the Starchart) and the CHAPTER ONE card, then HALCYON at her projector. Scripted scenes after their first box run fast (software GL renders well under 1 fps)"},
  {"waitFor": "window.__VP && window.__VP.ready", "timeout": 240000},
  {"eval": "window.S = () => window.__VP.debug.state()"},
  {"eval": "window.BATTLE = () => S().state === 'battle' && !!(S().battle && S().battle.results || document.querySelector('.vb-say.is-on.is-done'))"},
  {"waitFor": "S().state === 'title' && S().ui.title === 'press'", "timeout": 120000},
  {"key": "Enter"}, {"waitFor": "S().ui.title === 'menu'"}, {"wait": 700},
  {"eval": "__VP.debug.skip(true)"},
  {"key": "Enter"},
  {"waitFor": "S().map === 'halcyon' && S().cutscene === null && !S().transitioning && !S().ui.blocking", "timeout": 400000},
  {"eval": "__VP.debug.skip(false)"},
  {"eval": "__VP.debug.jumpTo('poc')"},
  {"waitFor": "S().partyIds.length === 4 && S().map === 'halcyon' && !S().transitioning && S().objective === 'pro.find_keycard'", "timeout": 240000},
  {"eval": "__VP.debug.encounters(false)"},

  {"note": "Coolant Gallery: Brandt's crate behind the pumps holds the Bridge Keycard"},
  {"eval": "__VP.debug.teleport(16.9, 36.9, 'left')"},
  {"until": "S().ui.prompt === 'Open'", "max": 40, "do": [{"hold": "ArrowLeft", "ms": 800}]},
  {"key": "Enter"},
  {"waitFor": "S().inventory.keycard === 1 && S().flags['chest:halcyon:brandt'] === true", "timeout": 120000},
  {"waitFor": "S().ui.dialog", "timeout": 400000},
  {"waitFor": "document.querySelector('.vp-dlg.is-waiting')", "timeout": 400000},
  {"wait": 1800},
  {"shot": "01-keycard-found"},
  {"eval": "__VP.debug.skip(true)"},
  {"until": "!S().ui.dialog && S().cutscene === null", "max": 200, "do": [{"if": "S().ui.dialog", "then": [{"key": "Enter"}]}, {"wait": 1500}]},
  {"waitFor": "S().objective === 'pro.open_bridge'", "timeout": 60000},

  {"note": "Antechamber: rest at the Med-Station (Restore), then the keycard on the bridge door panel"},
  {"eval": "window.CP0 = JSON.stringify(S().checkpoint), true"},
  {"eval": "__VP.debug.choices([0])"},
  {"eval": "__VP.debug.teleport(44.5, 13.5, 'up')"},
  {"eval": "__VP.debug.interact('med_ante')"},
  {"waitFor": "JSON.stringify(S().checkpoint) !== CP0 && S().cutscene === null && S().party.every((p) => p.hp === p.maxHp)", "timeout": 400000},
  {"eval": "__VP.debug.teleport(41.0, 13.4, 'up')"},
  {"eval": "__VP.debug.interact('bridge_door')"},
  {"waitFor": "S().flags['story:bridge_unlocked'] === true", "timeout": 120000},
  {"wait": 1500},
  {"shot": "02-door-unlocked"},
  {"note": "Nyx has a word about the open door"},
  {"until": "S().flags['seen:halcyon:bridge_open'] && S().cutscene === null", "max": 200, "do": [{"if": "S().ui.dialog", "then": [{"key": "Enter"}]}, {"wait": 1500}]},
  {"waitFor": "S().objective === 'pro.sentinel'", "timeout": 60000},
  {"eval": "__VP.debug.skip(false)"},
  {"eval": "__VP.debug.view('bridge')"},
  {"waitFor": "S().explore.area === 'bridge'", "timeout": 60000},
  {"wait": 1500},
  {"shot": "03-bridge"},

  {"note": "walk toward the SENTINEL until it confronts the squad"},
  {"eval": "__VP.debug.teleport(40.4, 8.2, 'up')"},
  {"until": "S().cutscene === 'prologue.sentinel' || S().state === 'battle'", "max": 60, "do": [
    {"down": "ArrowUp"}, {"down": "ArrowLeft"}, {"wait": 1500}, {"up": "ArrowLeft"}, {"up": "ArrowUp"}
  ]},
  {"waitFor": "S().ui.dialog", "timeout": 400000},
  {"waitFor": "document.querySelector('.vp-dlg.is-waiting')", "timeout": 400000},
  {"wait": 2200},
  {"shot": "04-sentinel-confront"},
  {"eval": "__VP.debug.skip(true)"},
  {"until": "S().inBattle", "max": 200, "do": [{"if": "S().ui.dialog", "then": [{"key": "Enter"}]}, {"wait": 1500}]},
  {"eval": "__VP.debug.skip(false)"},
  {"waitFor": "S().state === 'battle' && !S().transitioning", "timeout": 400000},
  {"waitFor": "S().music === 'boss' && S().battle.encounter === 'pro_boss_sentinel'", "timeout": 120000},
  {"eval": "__VP.debug.speed(3)"},

  {"note": "let the squad autoplay to its first Break on the SENTINEL (or round 2), then finish with debug.winBattle"},
  {"eval": "__VP.debug.pauseOn('break', 0.4)"},
  {"eval": "__VP.debug.autoplay('auto')"},
  {"until": "__VP.debug.paused || (S().battle && S().battle.round >= 2)", "max": 900, "do": [{"if": "!__VP.debug.paused && document.querySelector('.vb-say.is-on.is-done')", "then": [{"key": "Enter"}]}, {"wait": 1500}]},
  {"wait": 300},
  {"shot": "05-boss-break"},
  {"eval": "__VP.debug.resume()"},
  {"eval": "__VP.debug.winBattle()"},
  {"waitFor": "S().battle && S().battle.results", "timeout": 600000},
  {"wait": 1500},
  {"shot": "06-boss-victory"},
  {"eval": "__VP.debug.autoplay(false)"},
  {"eval": "__VP.debug.skip(true)"},
  {"until": "S().state === 'explore' && !S().transitioning", "max": 300, "do": [{"if": "BATTLE()", "then": [{"key": "Enter"}]}, {"wait": 1500}]},
  {"waitFor": "S().flags['defeated:pro_boss_sentinel'] === true", "timeout": 60000},

  {"note": "the aftermath (fast): HALCYON's fragment over the wreck, BOLT's tape; then the CHAPTER ONE card at its own pace"},
  {"until": "S().flags['story:prologue_done']", "max": 400, "do": [{"if": "S().ui.dialog", "then": [{"key": "Enter"}]}, {"wait": 1000}]},
  {"eval": "__VP.debug.skip(false)"},
  {"waitFor": "!!document.querySelector('.vp-chap.is-on')", "timeout": 400000},
  {"wait": 600},
  {"shot": "07-chapter-one-card"},
  {"waitFor": "S().chapter === 'ch1' && S().cutscene === null && !S().transitioning && !S().ui.blocking", "timeout": 600000},
  {"waitFor": "S().flags['story:prologue_done'] && S().flags['story:halcyon_fragment'] && S().flags['unlock:driftmarket'] && S().objective === 'ch1.go_driftmarket' && S().leader === 'nyx'"},
  {"waitFor": "S().music === 'explore'", "timeout": 60000},
  {"log": "JSON.stringify({ stats: S().stats, autosaves: S().autosaves, checkpoint: S().checkpoint })"},

  {"note": "HALCYON at her projector beside the Starchart"},
  {"eval": "__VP.debug.skip(false)"},
  {"eval": "__VP.debug.teleport(44.4, 9.7, 'right')"},
  {"eval": "__VP.debug.interact('halcyon')"},
  {"waitFor": "S().ui.dialog", "timeout": 240000},
  {"waitFor": "document.querySelector('.vp-dlg.is-waiting')", "timeout": 400000},
  {"wait": 2500},
  {"shot": "08-halcyon-after"},
  {"until": "!S().ui.dialog && S().cutscene === null", "max": 80, "do": [{"if": "S().ui.dialog", "then": [{"key": "Enter"}]}, {"wait": 1500}]},
  {"waitFor": "S().flags['talk:halcyon:halcyon'] === true", "timeout": 60000}
]
