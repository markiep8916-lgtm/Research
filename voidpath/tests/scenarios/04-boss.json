[
  {"note": "Boss: the keycard crate, the bridge door, the SENTINEL confrontation, a boss fight, victory and the complete screen"},
  {"waitFor": "window.__VP && window.__VP.ready", "timeout": 120000},
  {"eval": "window.S = () => window.__VP.debug.state()"},
  {"key": "Enter"}, {"wait": 700}, {"key": "Enter"},
  {"waitFor": "S().state === 'explore' && !S().transitioning", "timeout": 60000},
  {"eval": "__VP.debug.encounters(false)"},

  {"note": "Engineering Bay: open the crate that holds the Bridge Keycard"},
  {"eval": "__VP.debug.teleport(32.9, 26.7, 'down')"},
  {"until": "S().ui.prompt === 'Open'", "max": 25, "do": [{"hold": "ArrowDown", "ms": 300}]},
  {"key": "Enter"},
  {"waitFor": "S().inventory.keycard === 1 && S().flags.crate_eng_2 === true", "timeout": 15000},
  {"waitFor": "S().ui.dialog", "timeout": 15000},
  {"wait": 1800},
  {"shot": "01-keycard-found"},
  {"until": "!S().ui.dialog", "max": 30, "do": [{"if": "S().ui.dialog", "then": [{"key": "Enter"}]}, {"wait": 900}]},

  {"note": "Antechamber: rest at the Med-Station, then unlock the bridge door"},
  {"eval": "__VP.debug.teleport(44.5, 13.5, 'up')"},
  {"until": "S().ui.prompt === 'Med-Station'", "max": 25, "do": [{"hold": "ArrowUp", "ms": 300}]},
  {"key": "Enter"},
  {"waitFor": "S().ui.dialog", "timeout": 15000},
  {"until": "S().ui.choice", "max": 10, "do": [{"key": "Enter"}, {"wait": 900}]},
  {"key": "Enter"},
  {"waitFor": "S().flags.rested === true && S().checkpoint !== null", "timeout": 15000},
  {"waitFor": "!S().ui.blocking", "timeout": 15000},
  {"eval": "__VP.debug.teleport(41.0, 13.6, 'up')"},
  {"until": "S().ui.prompt === 'Unlock'", "max": 25, "do": [{"hold": "ArrowUp", "ms": 300}]},
  {"key": "Enter"},
  {"waitFor": "S().flags.bridge_unlocked === true", "timeout": 15000},
  {"wait": 1500},
  {"shot": "02-door-unlocked"},
  {"until": "S().explore.area === 'bridge'", "max": 40, "do": [{"hold": "ArrowUp", "ms": 400}]},
  {"wait": 800},
  {"shot": "03-bridge"},
  {"wait": 3500},
  {"hold": "ArrowUp", "ms": 600},
  {"waitFor": "S().state === 'explore' && !S().ui.dialog && S().explore.area === 'bridge'"},
  {"shot": "03b-bridge-walk"},

  {"note": "walk toward the SENTINEL until it confronts the squad"},
  {"until": "S().ui.dialog || S().state === 'battle'", "max": 40, "do": [
    {"down": "ArrowUp"}, {"down": "ArrowLeft"}, {"wait": 400}, {"up": "ArrowLeft"}, {"up": "ArrowUp"}
  ]},
  {"wait": 2200},
  {"shot": "04-sentinel-confront"},
  {"until": "!S().ui.dialog", "max": 30, "do": [{"if": "S().ui.dialog", "then": [{"key": "Enter"}]}, {"wait": 900}]},
  {"waitFor": "S().state === 'battle' && !S().transitioning", "timeout": 60000},
  {"waitFor": "S().music === 'boss' && S().battle.encounter === 'boss_sentinel'"},
  {"eval": "__VP.debug.speed(3)"},
  {"waitFor": "S().battle.menu === 'main'", "timeout": 180000},
  {"wait": 800},
  {"shot": "05-boss-menu"},

  {"note": "let the squad autoplay into the SENTINEL's lock-on, then finish with debug.winBattle"},
  {"eval": "__VP.debug.pauseOn('telegraph', 0.7)"},
  {"eval": "__VP.debug.autoplay('auto')"},
  {"waitFor": "__VP.debug.paused", "timeout": 600000},
  {"shot": "06-boss-lock-on"},
  {"eval": "__VP.debug.resume()"},
  {"eval": "__VP.debug.winBattle()"},
  {"waitFor": "S().battle && S().battle.results", "timeout": 240000},
  {"wait": 1500},
  {"shot": "07-boss-victory"},
  {"key": "Enter"},
  {"waitFor": "S().ui.screen === 'Proof of concept complete'", "timeout": 60000},
  {"waitFor": "S().flags.boss_defeated === true && S().music === 'title' && S().state === 'explore'"},
  {"wait": 3500},
  {"shot": "08-complete"},
  {"log": "JSON.stringify(S().stats)"},

  {"note": "Continue exploring: the SENTINEL is gone and HALCYON has new lines"},
  {"until": "!S().ui.screen", "max": 15, "do": [{"key": "Enter"}, {"wait": 1500}]},
  {"waitFor": "!S().ui.blocking && S().music === 'explore'", "timeout": 15000},
  {"waitFor": "S().explore.boss === false"},
  {"eval": "__VP.debug.teleport(44.1, 9.5, 'right')"},
  {"until": "S().ui.prompt === 'Talk'", "max": 25, "do": [{"hold": "ArrowRight", "ms": 250}]},
  {"key": "Enter"},
  {"waitFor": "S().ui.dialog", "timeout": 15000},
  {"wait": 2500},
  {"shot": "09-halcyon-after"},
  {"until": "!S().ui.dialog", "max": 30, "do": [{"if": "S().ui.dialog", "then": [{"key": "Enter"}]}, {"wait": 900}]}
]
