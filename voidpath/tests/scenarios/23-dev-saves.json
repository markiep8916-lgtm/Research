[
  {"note": "Med-Station save, page reload and Continue restore map, position, party, inventory, flags and play time"},
  {"waitFor": "window.__VP && window.__VP.ready", "timeout": 240000},
  {"eval": "window.S = () => window.__VP.debug.state()"},
  {"eval": "__VP.debug.jumpTo('dev')"},
  {"waitFor": "S().state === 'explore' && S().map === 'dev_box' && !S().transitioning", "timeout": 240000},
  {"eval": "__VP.debug.encounters(false)"},
  {"eval": "__VP.debug.give('ether', 2), __VP.debug.flags({ 'dev:saved_flag': true }), __VP.debug.credits(321), true"},

  {"note": "Med-Station > Save > File 1"},
  {"eval": "__VP.debug.teleport(12.6, 9.7, 'up')"},
  {"until": "S().ui.prompt", "max": 20, "do": [{"hold": "ArrowUp", "ms": 1200}]},
  {"key": "Enter"},
  {"waitFor": "S().ui.choice", "timeout": 60000},
  {"wait": 1200},
  {"shot": "01-med-station"},
  {"key": "ArrowDown"},
  {"wait": 600},
  {"key": "Enter"},
  {"waitFor": "S().ui.saves", "timeout": 60000},
  {"wait": 1500},
  {"shot": "02-save-picker"},
  {"until": "!S().ui.saves", "max": 6, "do": [{"key": "Enter"}, {"wait": 1500}]},
  {"waitFor": "S().cutscene === null && __VP.debug.listSaves().some((s) => s.slot === 'slot1' && !s.empty)", "timeout": 60000},
  {"eval": "(() => { const s = S(); sessionStorage.setItem('vp.before', JSON.stringify({ map: s.map, x: s.explore.x, z: s.explore.z, party: s.party, inventory: s.inventory, credits: s.credits, flags: s.flags, playTime: s.stats.playTime, leader: s.leader })); })(), true"},
  {"log": "sessionStorage.getItem('vp.before')"},

  {"note": "reload the page, then Continue from the title"},
  {"eval": "setTimeout(() => location.reload(), 50), true"},
  {"wait": 2000},
  {"waitFor": "window.__VP && window.__VP.ready", "timeout": 240000},
  {"eval": "window.S = () => window.__VP.debug.state()"},
  {"waitFor": "S().state === 'title' && S().ui.title === 'press'"},
  {"key": "Enter"},
  {"waitFor": "S().ui.title === 'menu'", "timeout": 60000},
  {"wait": 1500},
  {"shot": "03-title-continue"},
  {"key": "Enter"},
  {"waitFor": "S().state === 'explore' && !S().transitioning", "timeout": 400000},
  {"wait": 1200},
  {"shot": "04-continued"},
  {"eval": "window.B = JSON.parse(sessionStorage.getItem('vp.before')), true"},
  {"log": "JSON.stringify({ map: S().map, x: S().explore.x, z: S().explore.z, leader: S().leader, credits: S().credits, playTime: S().stats.playTime })"},
  {"waitFor": "S().map === B.map && Math.abs(S().explore.x - B.x) < 0.05 && Math.abs(S().explore.z - B.z) < 0.05 && S().leader === B.leader"},
  {"waitFor": "JSON.stringify(S().party.map((p) => [p.id, p.level, p.hp, p.ep])) === JSON.stringify(B.party.map((p) => [p.id, p.level, p.hp, p.ep]))"},
  {"waitFor": "JSON.stringify(S().inventory) === JSON.stringify(B.inventory) && S().credits === B.credits"},
  {"waitFor": "Object.keys(B.flags).every((k) => S().flags[k] === B.flags[k]) && S().flags['dev:saved_flag'] === true"},
  {"waitFor": "S().stats.playTime >= B.playTime && S().stats.playTime < B.playTime + 120"}
]
