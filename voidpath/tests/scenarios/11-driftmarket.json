[

  {"note": "Chapter 1, Driftmarket (C2): jumpTo('ch1') -> the bridge Starchart -> the Moth to Driftmarket -> the arrival (Ruse, Pip's rhyme, the tips) -> Ruse and the Maw -> the shop -> Tobin's legend -> the Shoals hatch; then jumpTo('ch1.return') -> the return at the viewport -> home on the Moth -> the coil in Engineering -> WARDEN -> the CHAPTER TWO card"},
  {"waitFor": "window.__VP && window.__VP.ready", "timeout": 300000},
  {"eval": "window.S = () => window.__VP.debug.state()"},
  {"eval": "__VP.debug.jumpTo('ch1').then((s) => { window.J = s; })"},
  {"waitFor": "window.J && S().state === 'explore' && !S().transitioning && S().map === 'halcyon'", "timeout": 300000},
  {"eval": "__VP.debug.encounters(false)"},
  {"eval": "__VP.debug.skip(true)"},
  {"eval": "(window.CAPS = [], window.CAP0 = __VP.ctx.ui.cards.caption.bind(__VP.ctx.ui.cards), __VP.ctx.ui.cards.caption = (t, o) => (CAPS.push(t), CAP0(t, o)))"},
  {"log": "JSON.stringify({ chapter: S().chapter, objective: S().objective, leader: S().leader, party: S().partyIds })"},

  {"note": "the Starchart on the bridge: Driftmarket is the new node; set course"},
  {"eval": "__VP.debug.interact('starchart')"},
  {"waitFor": "S().ui.starchart", "timeout": 120000},
  {"wait": 6000},
  {"shot": "01-starchart"},

  {"note": "the Moth flight and the arrival run fast; shots catch the boxes as they come"},
  {"key": "Enter"},
  {"waitFor": "S().map === 'driftmarket' && (S().cutscene === 'driftmarket.arrival' || S().flags['story:ruse_met'])", "timeout": 1200000},
  {"until": "/PIP/.test((document.querySelector('.vp-dlg.is-open .vp-dlg-name') || {}).textContent || '') || (S().flags['story:ruse_met'])", "max": 3000, "do": [{"wait": 200}]},
  {"shot": "02-arrival-pip"},
  {"until": "/HARL|NYX/.test((document.querySelector('.vp-dlg.is-open .vp-dlg-name') || {}).textContent || '') || (S().flags['story:ruse_met'])", "max": 3000, "do": [{"wait": 200}]},
  {"shot": "03-arrival-harl"},
  {"until": "/RUSE/.test((document.querySelector('.vp-dlg.is-open .vp-dlg-name') || {}).textContent || '') || (S().flags['story:ruse_met'])", "max": 3000, "do": [{"wait": 200}]},
  {"shot": "04-arrival-ruse"},
  {"waitFor": "S().flags['story:ruse_met'] && !S().cutscene", "timeout": 1200000},
  {"waitFor": "S().objective === 'ch1.ask_ruse' && S().flags['seen:driftmarket:arrival']", "timeout": 60000},
  {"note": "Nyx says it in her own words; the menu path is a caption (G2 C2-4)"},
  {"waitFor": "CAPS.includes('Pause menu · Party · Leader')", "timeout": 30000},
  {"wait": 6000},
  {"shot": "05-after-arrival"},

  {"note": "Ruse at her stall: the Maw; the hatch rolls up"},
  {"eval": "__VP.debug.teleport(40.6, 5.6, 'up')"},
  {"wait": 6000},
  {"shot": "06-ruse-shop"},
  {"waitFor": "!S().cutscene && !S().transitioning", "timeout": 1200000},
  {"eval": "__VP.debug.interact('ruse')"},
  {"waitFor": "S().flags['story:maw_lore'] && !S().cutscene", "timeout": 1200000},
  {"waitFor": "S().objective === 'ch1.reach_wreck'", "timeout": 60000},

  {"note": "the shop opens from her stock (the till) and from her talk"},
  {"waitFor": "!S().cutscene && !S().transitioning", "timeout": 1200000},
  {"eval": "__VP.debug.interact('ruse_shop')"},
  {"waitFor": "S().ui.shop", "timeout": 120000},
  {"note": "a tier-2 weapon for each traveler (G2 C2-2)"},
  {"waitFor": "['Arc Saber', 'Ring Rifle', 'Coil Gauntlet', 'Lumen Lance'].every((n) => document.querySelector('#ui-root').textContent.includes(n))", "timeout": 30000},
  {"wait": 6000},
  {"shot": "07-shop"},
  {"key": "Escape"},
  {"waitFor": "!S().ui.shop && !S().cutscene", "timeout": 120000},

  {"note": "Tobin tells the legend of the Lock"},
  {"eval": "__VP.debug.teleport(51.0, 5.6, 'left')"},
  {"wait": 1000},
  {"waitFor": "!S().cutscene && !S().transitioning", "timeout": 1200000},
  {"eval": "__VP.debug.interact('tobin')"},
  {"waitFor": "S().flags['dm:legend_heard'] && !S().cutscene", "timeout": 1200000},

  {"note": "out through the Shoals hatch"},
  {"eval": "__VP.debug.teleport(57.6, 14.0, 'right')"},
  {"wait": 6000},
  {"shot": "08-hatch-open"},
  {"until": "S().transitioning || S().map === 'shoals'", "max": 120, "do": [{"hold": "ArrowRight", "ms": 2500}]},
  {"waitFor": "S().map === 'shoals' && !S().transitioning", "timeout": 1200000},
  {"log": "JSON.stringify({ map: S().map, objective: S().objective, flags: Object.keys(S().flags).filter((f) => /^(story|dm|seen|talk):/.test(f)) })"},

  {"note": "after the Maw: back at the dock, the return plays (load trigger), Nyx joins for real"},
  {"waitFor": "!S().cutscene && !S().transitioning", "timeout": 1200000},
  {"eval": "__VP.debug.jumpTo('ch1.return', { play: true })"},
  {"waitFor": "S().map === 'driftmarket' && (S().cutscene === 'driftmarket.return' || S().flags['story:nyx_for_real'])", "timeout": 1200000},
  {"until": "/Ione/.test((document.querySelector('.vp-dlg.is-open .vp-dlg-text') || {}).textContent || '') || (S().flags['story:nyx_for_real'])", "max": 3000, "do": [{"wait": 200}]},
  {"shot": "09a-return-ione"},
  {"until": "(S().inventory.data_spike || 0) === 1 || (S().flags['story:nyx_for_real'])", "max": 3000, "do": [{"wait": 200}]},
  {"shot": "09b-return-spike"},
  {"waitFor": "S().flags['story:nyx_for_real'] && S().flags['story:ringborn_seeding'] && !S().cutscene", "timeout": 1200000},
  {"note": "Ruse's spike is a key item now, named on screen by its toast (G2 C2-5)"},
  {"waitFor": "S().inventory.data_spike === 1", "timeout": 30000},
  {"waitFor": "S().objective === 'ch1.install_coil'", "timeout": 60000},
  {"wait": 6000},
  {"shot": "09-after-return"},

  {"note": "home on the Moth from the dock Starchart"},
  {"eval": "__VP.debug.teleport(13.6, 6.2, 'up')"},
  {"waitFor": "!S().cutscene && !S().transitioning", "timeout": 1200000},
  {"eval": "__VP.debug.interact('starchart')"},
  {"waitFor": "S().ui.starchart", "timeout": 120000},
  {"wait": 800},
  {"key": "Enter"},
  {"waitFor": "S().map === 'halcyon' && !S().transitioning && !S().cutscene", "timeout": 1200000},

  {"note": "the coil goes in: WARDEN speaks; the manifest; the CHAPTER TWO card"},
  {"eval": "__VP.debug.teleport(25.5, 26.4, 'up')"},
  {"wait": 1000},
  {"waitFor": "!S().cutscene && !S().transitioning", "timeout": 1200000},
  {"eval": "__VP.debug.interact('dm.coil_socket')"},
  {"waitFor": "S().cutscene === 'driftmarket.coil_install' || S().flags['story:coil_installed']", "timeout": 1200000},
  {"until": "/WARDEN/.test((document.querySelector('.vp-dlg.is-open .vp-dlg-name') || {}).textContent || '') || (S().flags['story:ch1_done'])", "max": 3000, "do": [{"wait": 200}]},
  {"shot": "10-warden-speaks"},
  {"waitFor": "S().chapter === 'ch2' && S().flags['story:ch1_done'] && S().map === 'halcyon' && !S().cutscene && !S().transitioning", "timeout": 1200000},
  {"waitFor": "S().leader === 'sera' && S().flags['story:coil_installed'] && S().flags['story:warden_speaks'] && S().flags['unlock:arboretum'] && !S().inventory.lattice_coil", "timeout": 60000},
  {"waitFor": "!S().inventory.data_spike && !S().flags['dm:warden_light']", "timeout": 30000},
  {"wait": 6000},
  {"shot": "11-ch2-bridge"},
  {"log": "JSON.stringify({ chapter: S().chapter, objective: S().objective, leader: S().leader, autosaves: S().autosaves, recap: __VP.ctx.story.journal().recaps.map((r) => r.chapter) })"},
  {"waitFor": "__VP.ctx.story.journal().recaps.some((r) => r.chapter === 'ch1')", "timeout": 10000}
]
