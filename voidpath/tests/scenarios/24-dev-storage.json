[
  {"note": "localStorage forced to throw: the game keeps playing, saves go to memory and the notice shows once"},
  {"waitFor": "window.__VP && window.__VP.ready", "timeout": 240000},
  {"eval": "Storage.prototype.setItem = () => { throw new Error('storage blocked'); }, true"},
  {"eval": "window.S = () => window.__VP.debug.state()"},
  {"eval": "__VP.debug.jumpTo('dev')"},
  {"waitFor": "S().state === 'explore' && S().map === 'dev_box' && !S().transitioning", "timeout": 240000},
  {"eval": "__VP.debug.encounters(false)"},
  {"note": "an exit autosaves: the write falls back to memory and the notice appears"},
  {"eval": "__VP.debug.teleport(4.95, 20.4, 'down')"},
  {"until": "S().transitioning || S().map === 'halcyon'", "max": 12, "do": [{"hold": "ArrowDown", "ms": 2500}]},
  {"waitFor": "S().map === 'halcyon' && !S().transitioning", "timeout": 240000},
  {"waitFor": "S().autosaves === 1 && S().ui.toasts.some((t) => t.includes('Saving is unavailable'))", "timeout": 30000},
  {"wait": 600},
  {"shot": "01-memory-notice"},
  {"note": "keep playing: back to dev_box (a second autosave, no second notice), then Title and Continue from memory"},
  {"eval": "__VP.debug.interact('dev.door')"},
  {"waitFor": "S().map === 'dev_box' && !S().transitioning && S().autosaves === 2", "timeout": 240000},
  {"wait": 800},
  {"log": "JSON.stringify({ toasts: S().ui.toasts, saves: __VP.debug.listSaves().map((s) => [s.slot, s.empty]) })"},
  {"eval": "__VP.game.toTitle()"},
  {"waitFor": "S().state === 'title' && !S().transitioning", "timeout": 240000},
  {"key": "Enter"},
  {"waitFor": "S().ui.title === 'menu'", "timeout": 60000},
  {"wait": 1200},
  {"shot": "02-title-continue-from-memory"},
  {"key": "Enter"},
  {"waitFor": "S().state === 'explore' && !S().transitioning && S().map === 'dev_box'", "timeout": 400000},
  {"wait": 1000},
  {"shot": "03-continued"},
  {"hold": "ArrowUp", "ms": 1200},
  {"waitFor": "S().explore.z < 17.3"}
]
