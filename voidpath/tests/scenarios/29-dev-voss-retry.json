[
  {"note": "G3-08 (F-2): losing to Commander Voss, a trigger-script boss (on:'enter' rect), and choosing Retry: after another script runs first (a Med-Station visit), walking into her rect again goes straight to the battle with no pre-fight line; the aftermath then plays normally"},
  {"waitFor": "window.__VP && window.__VP.ready", "timeout": 240000},
  {"eval": "window.S = () => window.__VP.debug.state()"},
  {"eval": "__VP.debug.jumpTo('ch3.voss')"},
  {"waitFor": "S().state === 'explore' && S().map === 'spire' && !S().transitioning && !S().cutscene", "timeout": 900000},
  {"eval": "__VP.debug.encounters(false)"},
  {"eval": "__VP.debug.autoResolve('lose')"},
  {"eval": "window.__says = 0, (() => { const d = __VP.ctx.ui.dialog; const show = d.show.bind(d); d.show = (l, o) => (__says++, show(l, o)); })(), true"},

  {"note": "first approach: the scene plays (sped up), then the battle is lost"},
  {"eval": "__VP.debug.skip(true)"},
  {"eval": "__VP.debug.teleport(56.5, 8.5, 'left')"},
  {"until": "S().cutscene === 'spire.voss'", "max": 20, "do": [{"hold": "ArrowLeft", "ms": 2500}]},
  {"until": "S().inBattle || S().ui.screen", "max": 600, "do": [{"if": "S().ui.dialog", "then": [{"key": "Enter"}]}, {"wait": 500}]},
  {"waitFor": "S().ui.screen === 'Signal lost'", "timeout": 600000},
  {"log": "JSON.stringify({ firstSays: __says, retried: __VP.ctx.game._battle && __VP.ctx.game._battle.script })"},
  {"waitFor": "__says > 5 && !S().flags['seen:spire:voss']"},
  {"wait": 1500},
  {"shot": "01-game-over"},

  {"note": "Retry, then another script runs first (it spends Retry's own auto-skip, as a Med-Station visit does)"},
  {"eval": "__VP.debug.skip(false)"},
  {"until": "!S().ui.screen", "max": 20, "do": [{"key": "Enter"}, {"wait": 1500}]},
  {"waitFor": "S().state === 'explore' && !S().transitioning && S().map === 'spire' && S().cutscene === null", "timeout": 600000},
  {"waitFor": "S().party.every((p) => p.alive && p.hp === p.maxHp)"},
  {"eval": "__VP.debug.runScript(async function medVisit(cs) { await cs.wait(0.3); })"},
  {"waitFor": "S().cutscene === null && !__VP.ctx.cutscenes.autoSkip", "timeout": 60000},
  {"wait": 800},
  {"shot": "02-retry-at-checkpoint"},

  {"note": "second approach: straight to the battle (no dialog line), won"},
  {"eval": "__VP.debug.autoResolve('win'), window.__says = 0, true"},
  {"eval": "__VP.debug.teleport(56.5, 8.5, 'left')"},
  {"until": "S().cutscene === 'spire.voss'", "max": 20, "do": [{"hold": "ArrowLeft", "ms": 2500}]},
  {"waitFor": "S().inBattle || S().ui.dialog", "timeout": 300000},
  {"log": "JSON.stringify({ says: __says, inBattle: S().inBattle, flare: S().flags['story:flare_report'] })"},
  {"waitFor": "__says === 0 && S().flags['story:flare_report'] === true", "timeout": 1000},

  {"note": "the aftermath plays normally: Voss's last lines, the Command Key, the CHAPTER FOUR card"},
  {"waitFor": "S().ui.dialog && !S().inBattle", "timeout": 600000},
  {"waitFor": "__says >= 1"},
  {"wait": 1500},
  {"shot": "03-aftermath"},
  {"eval": "__VP.debug.skip(true)"},
  {"until": "S().chapter === 'ch4' && S().cutscene === null && !S().transitioning", "max": 600, "do": [{"if": "S().ui.dialog", "then": [{"key": "Enter"}]}, {"wait": 700}]},
  {"waitFor": "S().flags['story:ch3_done'] && S().flags['defeated:spire_boss_voss'] && S().inventory.command_key === 1", "timeout": 30000},
  {"log": "JSON.stringify({ chapter: S().chapter, map: S().map, objective: S().objective })"}
]
