[
  {"note": "Defeat: log a checkpoint, lose a battle at 1 HP, Game Over -> Retry -> back at the checkpoint with the squad restored"},
  {"waitFor": "window.__VP && window.__VP.ready", "timeout": 240000},
  {"eval": "window.S = () => window.__VP.debug.state()"},
  {"key": "Enter"},
  {"waitFor": "S().ui.title === 'menu'", "timeout": 60000},
  {"wait": 1200},
  {"key": "Enter"},
  {"waitFor": "S().state === 'explore' && !S().transitioning", "timeout": 400000},
  {"eval": "__VP.debug.jumpTo('poc')"},
  {"waitFor": "S().partyIds.length === 4 && S().map === 'halcyon' && !S().transitioning", "timeout": 240000},
  {"eval": "__VP.debug.encounters(false)"},
  {"note": "log a checkpoint at the Cryo Deck Med-Station"},
  {"eval": "window.CP0 = JSON.stringify(S().checkpoint), true"},
  {"eval": "__VP.debug.teleport(12.6, 19.7, 'up')"},
  {"until": "S().ui.prompt === 'Med-Station'", "max": 25, "do": [{"hold": "ArrowUp", "ms": 300}]},
  {"key": "Enter"},
  {"waitFor": "S().ui.dialog", "timeout": 15000},
  {"until": "S().ui.choice", "max": 10, "do": [{"key": "Enter"}, {"wait": 900}]},
  {"key": "Enter"},
  {"waitFor": "S().cutscene === null && JSON.stringify(S().checkpoint) !== CP0", "timeout": 60000},
  {"log": "JSON.stringify(S().checkpoint)"},
  {"note": "a fight in the corridor with the whole squad at 1 HP, defending every turn"},
  {"eval": "__VP.debug.view('corridor')"},
  {"wait": 800},
  {"eval": "__VP.debug.startBattle('drone_pair', { seed: 5 })"},
  {"waitFor": "S().state === 'battle' && S().battle && (S().battle.menu === 'main' || S().battle.phase === 'enemyTurn')", "timeout": 180000},
  {"eval": "__VP.debug.partyHp(1)"},
  {"eval": "__VP.debug.speed(3)"},
  {"eval": "__VP.debug.autoplay('defend')"},
  {"waitFor": "S().battle && S().battle.result === 'defeat'", "timeout": 400000},
  {"waitFor": "S().ui.screen === 'Signal lost'", "timeout": 60000},
  {"waitFor": "S().music === null"},
  {"wait": 2500},
  {"shot": "01-game-over"},
  {"note": "Retry: the squad wakes at the Med-Station checkpoint"},
  {"until": "!S().ui.screen", "max": 15, "do": [{"key": "Enter"}, {"wait": 1500}]},
  {"waitFor": "S().state === 'explore' && !S().ui.screen && S().explore.area === 'cryo'", "timeout": 400000},
  {"waitFor": "S().party.every((p) => p.alive && p.hp === p.maxHp)"},
  {"waitFor": "Math.abs(S().explore.x - S().checkpoint.x) < 0.01 && Math.abs(S().explore.z - S().checkpoint.z) < 0.01"},
  {"waitFor": "S().music === 'explore'"},
  {"wait": 1500},
  {"shot": "02-retry-at-checkpoint"},
  {"until": "S().explore.z > S().checkpoint.z + 0.2", "max": 8, "do": [{"hold": "ArrowDown", "ms": 2500}]},
  {"shot": "03-walking-again"}
]
