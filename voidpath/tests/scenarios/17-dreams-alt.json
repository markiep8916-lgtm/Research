[
  {"note":"C8 dreams, alt: Sera leads. jumpTo('finale', play) -> the Starchart -> the night before declined ('Go now.') -> the flight -> the Heart; the four dreams in order (Kade: Stay. then the refusal; Nyx: Wake up.; Orion: Stay.; Sera at reading speed with frames, Stay.), each back to the exact spot with its keepsake -> the Sanctum -> the crown lift -> dreams.crown (fast approach, WARDEN won through the model) -> the resolution at reading speed with Sera leading (frames) -> the EPILOGUE card keeps Sera leading -> halcyon:cryo -> the epilogue begins"},
  {"waitFor":"window.__VP && window.__VP.ready","timeout":3600000},
  {"eval":"window.S = () => window.__VP.debug.state()"},
  {"eval":"window.DONE = () => !S().cutscene && !S().transitioning && !S().inBattle"},
  {"eval":"window.IDLE = () => S().state === 'explore' && !S().transitioning && !S().cutscene && !S().ui.blocking"},
  {"eval":"window.LEAD = (id) => (__VP.ctx.ui.hook('setLeader', id), S().leader === id)"},
  {"eval":"window.SAY = () => document.querySelector('.vb-say.is-on.is-done') || document.querySelector('.vb-tip.is-on') || (S().battle && S().battle.results)"},
  {"eval":"window.ADV = () => { const el = document.querySelector('.vp-dlg.is-open'); if (!el) { window.__advK = null; return false; } if (S().ui.choice || !(S().cutscene && __VP.ctx.cutscenes.fast)) return true; const k = el.textContent; if (window.__advK !== k) { window.__advK = k; window.__advT = Date.now(); return false; } return Date.now() - window.__advT > 4000; }"},
  {"eval":"window.TEXT = () => document.querySelector('.vp-dlg.is-open')?.textContent || ''"},
