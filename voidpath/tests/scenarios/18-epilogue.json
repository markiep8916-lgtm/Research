  {"eval":"window.ADV = () => { const el = document.querySelector('.vp-dlg.is-open'); if (!el) { window.__advK = null; return false; } if (S().ui.choice || !(S().cutscene && __VP.ctx.cutscenes.fast)) return true; const k = el.textContent; if (window.__advK !== k) { window.__advK = k; window.__advT = Date.now(); return false; } return Date.now() - window.__advT > 4000; }"},
  {"eval":"window.TEXT = () => document.querySelector('.vp-dlg.is-open')?.textContent || ''"},
